<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tap.Hosting</RootNamespace>
    <AssemblyName>Tap.Aspire.Hosting</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Tap.Aspire.Hosting</PackageId>
    <TapProductIcon>Tunnels</TapProductIcon>
    <Title>Tap.Aspire.Hosting</Title>
    <Description>Aspire AppHost integration for Tap Tunnels — local HTTP tunnels with inspection built in. Adds AddTap(), tap.WithTunnel()/WithQuickTunnel(), and the WithTap() resource decorator to your Aspire AppHost.</Description>
    <PackageTags>aspire;integration;hosting;http;inspector;proxy;cloudflare;cloudflared;tunnel;ngrok;tap</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
    <ProjectReference Include="..\Tap.Core\Tap.Core.csproj" />
  </ItemGroup>

  <!--
    Note: AddTap references Projects.Tap_Server. That generated type comes from
    the Aspire.AppHost.Sdk in the *consumer's* AppHost csproj, so consumers must also add
    a ProjectReference to Tap.Server. In a future packaged release we'll embed the
    published Tap.Server binary in the nupkg and switch to AddExecutable.
  -->
</Project>
