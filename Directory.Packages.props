<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <AspireVersion>13.4.6</AspireVersion>
    <AspNetCoreVersion>10.0.11</AspNetCoreVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Aspire.AppHost.Sdk" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="$(AspireVersion)" />
    <!-- Transitive pin: StreamJsonRpc pulls MessagePack 2.5.192 which has GHSA-hv8m-jj95-wg3x (fixed in 2.5.301). -->
    <PackageVersion Include="MessagePack" Version="3.1.8" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <!-- Spectre.Console.Cli ships from its own repo and its newest stable is 0.55.0
         (later versions are 1.0.0-alpha only). It floats up to Spectre.Console 0.57.2. -->
    <PackageVersion Include="Spectre.Console.Cli" Version="0.55.0" />
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- RFC 9535 JSONPath over System.Text.Json nodes — backs the `jsonpath:` assertion
         extractor. Chosen over the alternatives because it binds to JsonNode directly and
         keeps the repo free of a reflection-based serializer. -->
    <PackageVersion Include="JsonPath.Net" Version="3.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(AspNetCoreVersion)" />
    <!-- Official MCP C# SDK — backs `tap-studio mcp` (stdio server over the agent surface).
         Microsoft.Extensions.Hosting is its host loop; the CLI only pulls it for that command. -->
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.11.0" />
    <PackageVersion Include="LibGit2Sharp" Version="0.32.0" />

    <!-- Test dependencies — only consumed by src/backend/Tap.Tests. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />

    <!-- Demo.Api dependencies — only consumed by samples/Demo.Api. -->
    <PackageVersion Include="HotChocolate.AspNetCore" Version="16.6.0" />
    <PackageVersion Include="HotChocolate.Subscriptions.InMemory" Version="16.6.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="OpenIddict.AspNetCore" Version="7.6.0" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.6.0" />
  </ItemGroup>
</Project>
