<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Default: don't pack. Packable projects opt in with <IsPackable>true</IsPackable>. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Shared NuGet metadata applied to every packable project. Individual
       projects override PackageId, AssemblyName, Description, and PackageTags. -->
  <PropertyGroup>
    <Authors>Tap contributors</Authors>
    <Company>Tap contributors</Company>
    <Copyright>Copyright (c) Tap contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/philbir/tap</PackageProjectUrl>
    <RepositoryUrl>https://github.com/philbir/tap</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Version Condition="'$(Version)' == ''">0.1.0-local</Version>
  </PropertyGroup>

  <!-- Pack the shared README into every packable project. Product-specific package
       icons are selected after each project is evaluated in Directory.Build.targets. -->
  <!-- Projects that ship their own README opt out by setting PackageReadmeFile themselves;
       packing both to the same path is an error. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true' AND !Exists('$(MSBuildProjectDirectory)/README.md')">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
