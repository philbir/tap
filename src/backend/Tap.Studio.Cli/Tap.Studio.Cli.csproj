<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tap.Studio.Cli</RootNamespace>
    <AssemblyName>tap-studio</AssemblyName>

    <!-- .NET tool packaging. Deliberately a different package and command from the Tap Tunnels
         `tap` CLI: different product, and both should be installable together. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tap-studio</ToolCommandName>
    <IsPackable>true</IsPackable>
    <PackageId>Tap.Studio.Cli</PackageId>
    <TapProductIcon>Studio</TapProductIcon>
    <Title>Tap Studio CLI</Title>
    <Description>Run Tap workspace requests, flows, and test sets from a terminal or from CI. Install as a global .NET tool: `dotnet tool install -g Tap.Studio.Cli`, then `tap-studio test &lt;name&gt;`. Reports to the console, JUnit, TRX, or JSON, and exits non-zero when a test fails.</Description>
    <PackageTags>tap;http-client;api-testing;ci;dotnet-tool;junit</PackageTags>
    <!-- Overrides the shared root README from Directory.Build.props: someone landing on this
         package's NuGet page wants the tool's usage, not the repo's overview. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The engine, and nothing that serves a UI. No Kestrel, no React bundle, no Git —
         this has to be cheap enough to install on every CI runner. Tap.Studio.Mcp is the
         shared MCP tool layer the `mcp` command serves over stdio. -->
    <ProjectReference Include="..\Tap.Execution\Tap.Execution.csproj" />
    <ProjectReference Include="..\Tap.Studio.Mcp\Tap.Studio.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- `agent init` installs the agent skills into consumer repos. They are embedded from
         the repo's own .claude/skills so there is exactly one source of truth — the skills
         this repo dogfoods are the skills the tool ships. LogicalName pins forward slashes
         via RecursiveDir (normalized at read time for Windows builds). -->
    <EmbeddedResource Include="../../../.claude/skills/tap-studio/**/*.md"
                      LogicalName="agent-skills/tap-studio/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../../.claude/skills/tap-author/**/*.md"
                      LogicalName="agent-skills/tap-author/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

</Project>
