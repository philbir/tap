{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "studio-api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/backend/Tap.Studio/Tap.Studio.csproj",
        "-p:SkipTapUiBuild=true",
        "--",
        "--Studio:WorkspaceRoot=samples/sample-workspace",
        "--Studio:Port=5298"
      ],
      "port": 5298
    },
    {
      "name": "studio-ui",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "STUDIO_API_URL=http://localhost:5298",
        "scripts/studio-ui-dev.sh"
      ],
      "port": 5297
    },
    {
      "name": "inspector-ui",
      "runtimeExecutable": "yarn",
      "runtimeArgs": ["--cwd", "src/ui-inspector", "dev", "--port", "5197", "--strictPort"],
      "port": 5197
    },
    {
      "name": "docs-site",
      "runtimeExecutable": "yarn",
      "runtimeArgs": ["--cwd", "docs-site", "dev", "--port", "5397", "--strictPort"],
      "port": 5397
    },
    {
      "name": "studio-aspire",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "echo 'attaching to aspire-managed studio on 55446'; while :; do sleep 3600; done"],
      "port": 55446
    }
  ]
}
