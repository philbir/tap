<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tap.Studio.Mcp</RootNamespace>
    <AssemblyName>Tap.Studio.Mcp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tap.Execution\Tap.Execution.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only the MCP core (attributes, McpException, server plumbing shared by every
         transport). Hosting stays with the hosts: the CLI adds stdio, Tap.Studio adds
         ModelContextProtocol.AspNetCore — this library must not force either on the other. -->
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

</Project>
