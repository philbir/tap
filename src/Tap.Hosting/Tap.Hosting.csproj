<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tap.Hosting</RootNamespace>
    <AssemblyName>Tap.Hosting</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Tap.Hosting</PackageId>
    <Description>Aspire AppHost integration for the Tap HTTP inspector and Cloudflared tunnel.</Description>
    <Authors>philbir</Authors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
  </ItemGroup>

  <!--
    Note: AddHttpInspector references Projects.Tap_Server. That generated type comes from
    the Aspire.AppHost.Sdk in the *consumer's* AppHost csproj, so consumers must also add
    a ProjectReference to Tap.Server. In a future packaged release we'll embed the
    published Tap.Server binary in the nupkg and switch to AddExecutable.
  -->
</Project>
