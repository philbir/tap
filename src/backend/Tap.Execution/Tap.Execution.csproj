<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tap.Execution</RootNamespace>
    <AssemblyName>Tap.Execution</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Tap.Execution</PackageId>
    <TapProductIcon>Studio</TapProductIcon>
    <Title>Tap.Execution</Title>
    <Description>Executes Tap workspace requests, flows, and test sets: HTTP transport, assertion evaluation, value extraction, and the sequential run engine. The engine behind both Tap Studio and the `tap-studio` CLI, so a verdict from CI and a verdict from the UI are the same computation.</Description>
    <PackageTags>tap;http-client;testing;api-testing;assertions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tap.Workspace\Tap.Workspace.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Deliberately narrow. No ASP.NET Core, no Git, no UI — this assembly has to be
         installable on a CI runner without dragging the Studio's web stack with it.
         Azure + the 1Password CLI shim are here so a headless run resolves secrets from
         exactly the providers the UI does; a CLI that silently supported fewer would
         break the "same verdict" promise the whole split exists to keep. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
  </ItemGroup>

</Project>
