<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Tap.Server</RootNamespace>
        <AssemblyName>Tap.Server</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Yarp.ReverseProxy" />
    </ItemGroup>

    <!-- Build the React inspector UI and sync it into wwwroot so the shipped binary
         serves a fully self-contained app. The ui/ directory is the source; the dist
         is copied into wwwroot here. The Web SDK picks up wwwroot automatically. -->
    <PropertyGroup>
        <TapUiDir>$(MSBuildThisFileDirectory)../../ui</TapUiDir>
        <TapUiDist>$(TapUiDir)/dist</TapUiDist>
        <TapUiWwwroot>$(MSBuildThisFileDirectory)wwwroot</TapUiWwwroot>
    </PropertyGroup>

    <Target Name="BuildTapUi" BeforeTargets="BeforeBuild" Condition="'$(SkipTapUiBuild)' != 'true' AND Exists('$(TapUiDir)/package.json')">
        <Exec Command="yarn install" WorkingDirectory="$(TapUiDir)" Condition="!Exists('$(TapUiDir)/.yarn/install-state.gz') AND !Exists('$(TapUiDir)/node_modules')" />
        <Exec Command="yarn build" WorkingDirectory="$(TapUiDir)" />
        <ItemGroup>
            <_TapUiDistFiles Include="$(TapUiDist)/**/*" />
        </ItemGroup>
        <Copy SourceFiles="@(_TapUiDistFiles)"
              DestinationFiles="@(_TapUiDistFiles->'$(TapUiWwwroot)/%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>

</Project>
