<Project Sdk="Aspire.AppHost.Sdk/13.4.2">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>tap-studio-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" />
  </ItemGroup>

  <ItemGroup>
    <!-- ProjectReference (not <Reference>) so the Aspire.AppHost.Sdk source generator
         emits Projects.Tap_Studio for AddProject<T>. -->
    <ProjectReference Include="..\..\src\backend\Tap.Studio\Tap.Studio.csproj" />
    <ProjectReference Include="..\Demo.Api\Demo.Api.csproj" />
  </ItemGroup>
</Project>
