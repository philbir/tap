# .NET
bin/
obj/
*.user
*.suo
.vs/

# Node / Vite
node_modules/
dist/
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/sdks
!**/.yarn/versions
.pnp.*
*.tsbuildinfo

# Bundled UI artifacts (regenerated by Tap.Server build target from ui/dist)
src/Tap.Server/wwwroot/*
!src/Tap.Server/wwwroot/.gitkeep


# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# Local secrets
*.local.json
appsettings.Development.json

# Pack output
artifacts/
*.nupkg
*.snupkg

# Tailscale cert files written into CWD by `tailscale cert <dns>` during funnel pre-warm
# (the CLI runner and AppHost bootstrapper both invoke this). The hostname is identifying,
# so don't commit them.
*.ts.net.crt
*.ts.net.key
